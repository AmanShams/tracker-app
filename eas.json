{
    "build": {
        "development": {
            "developmentClient": true,
            "distribution": "internal"
        },
        "preview": {
            "distribution": "internal",
            "android": {
                "buildType": "apk"
            },
            "env": {
                "ORG_GRADLE_PROJECT_reactNativeArchitectures": "arm64-v8a"
            }
        },
        "preview-lite": {
            "distribution": "internal",
            "android": {
                "buildType": "apk",
                "gradleCommand": ":app:assembleRelease",
                "env": {
                   "ORG_GRADLE_PROJECT_reactNativeArchitectures": "arm64-v8a"
                }
            }
        },
        "production": {}
    }
}